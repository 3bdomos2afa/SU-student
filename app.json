{
  "expo": {
    "name": "SU+",
    "slug": "abdelrahman",
    "version": "1.15.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unicodesis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unicodesis.student",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "unicodesis.su.edu.eg": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.unicodesis.student",
      "adaptiveIcon": {
        "backgroundColor": "#6A4BEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4F3F9",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#121118"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "UnicodeSIS uses Face ID to unlock your student portal."
        }
      ],
      "expo-localization",
      "./plugins/with-portal-network.cjs",
      "./plugins/with-android-no-minify.cjs",
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/su_chime.wav"
          ]
        }
      ],
      "expo-background-task",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "x3bdoxs-team",
    "extra": {
      "eas": {
        "projectId": "c4c85aa4-b3c8-43ca-a0dc-3baa0a99ab7a"
      }
    }
  }
}
