{
  "expo": {
    "name": "SU Student",
    "slug": "su-student",
    "version": "1.6.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unicodesis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unicodesis.student",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "unicodesis.su.edu.eg": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        }
      }
    },
    "android": {
      "package": "com.unicodesis.student",
      "adaptiveIcon": {
        "backgroundColor": "#172B68",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#EDF4FF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B132C"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "UnicodeSIS uses Face ID to unlock your student portal."
        }
      ],
      "expo-localization",
      "./plugins/with-portal-network.cjs",
      "expo-font",
      "expo-image",
      "expo-notifications",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "su_student",
    "extra": {
      "eas": {
        "projectId": "09b1d4d4-98bc-45bb-90c6-341574f34c05"
      }
    }
  }
}
