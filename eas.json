{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "google-test": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SU_GOOGLE_WEBVIEW_TEST": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
